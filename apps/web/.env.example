# Copy to .env.local (gitignored). See masterdoc.md section 12.2.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The two fixed accounts' real passwords (lib/characters.ts) - without these,
# the Lounge's inline sign-in picker will fail cleanly ("This ward is closed
# for cleaning").
VITE_SURYA_PASSWORD=
VITE_LAKSHMI_PASSWORD=
# host:port (no protocol) of the apps/rooms Cloudflare Worker - lib/use-room.ts.
# Defaults to local wrangler dev (127.0.0.1:8787) if unset, so this only needs
# a real value once the worker is actually deployed (e.g.
# ward-games-rooms.<your-subdomain>.workers.dev).
VITE_ROOMS_HOST=
